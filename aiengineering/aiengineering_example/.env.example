# ===============================================================================
# TEMPLATE DOKUMEN VARIABEL LINGKUNGAN (.env.example)
# ===============================================================================
# Salin file ini menjadi .env lalu isi nilainya:
# cp .env.example .env
# JANGAN PERNAH meng-commit file .env asli ke dalam repository Git!

# 1. Konfigurasi Ollama (Lokal - Default 100% Gratis)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_GENERATE_URL=http://localhost:11434/api/generate
OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
DEFAULT_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text

# 2. Konfigurasi Google Gemini API (Cloud - Free Tier)
# Dapatkan API Key gratis di: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy_GantiDenganAPIKeyGeminiAndaYangAsli

# 3. Konfigurasi Provider Lain (Opsional)
GROQ_API_KEY=gsk_GantiDenganAPIKeyGroqAnda
OPENAI_API_KEY=sk-GantiJikaMenggunakanOpenAI
